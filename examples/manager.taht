# Ayarlar
Game Settings (settings:main)
    description: "Osmanlı saray yönetim oyunu"
    game_over_on_zero: "Devlet çöktü!"
    game_over_on_max: "Saltanat sona erdi!"
    starting_flags: flag:start

# Ana kaynaklar
Hazine (counter:hazine, killer)
    start: 50
    icon: "💰"

Ordu (counter:ordu, killer)
    start: 50
    icon: "⚔️"

Reaya (counter:reaya, killer)
    start: 50
    icon: "👥"

Din (counter:din, killer)
    start: 50
    icon: "☪️"

# İmar sayaçları
Toplam Cami (counter:cami, keep)
    start: 0

Toplam Türbe (counter:turbe, keep)
    start: 0

Toplam Mesire Yeri (counter:mesire, keep)
    start: 0

Toplam Harem Ziyaret Sayısı (counter:haremziyaret)
    start: 0

Toplam Sehzade (counter:sehzade)
    start: 0

# Virtual counter: toplam imar
Toplam İmar (counter:toplam_imar)
    source: counter:cami, counter:turbe, counter:mesire
    aggregate: sum

# Yaş
Yaşın (counter:yas, keep)
    start: 18

# Durum flag'leri
Oyun Başladı (flag:start)
Savaş Var (flag:savas)
Verem Salgını Var (flag:verem)
